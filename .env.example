# Copy this file to .env. API keys in the shell environment take precedence.
# Settings changed in the UI are read from this file.
UNSPEAKABLE_TRANSLATIONS_ENABLE_OLLAMA=true
UNSPEAKABLE_TRANSLATIONS_TRANSLATEGEMMA_MODEL=translategemma:12b-it-q8_0
UNSPEAKABLE_TRANSLATIONS_CARD_IMAGE_PROVIDER=none

# Optional shared project source. Leave empty for a local-only workbench.
UNSPEAKABLE_TRANSLATIONS_PROJECTS_REPOSITORY=
UNSPEAKABLE_TRANSLATIONS_PROJECTS_BRANCH=main
UNSPEAKABLE_TRANSLATIONS_PROJECTS_CATALOG_URL=

# Google AI Studio / Gemini Developer API
GEMINI_API_KEY=
UNSPEAKABLE_TRANSLATIONS_GEMINI_MODEL=gemini-3.8-flash

# OpenAI Responses API for card images
OPENAI_API_KEY=
UNSPEAKABLE_TRANSLATIONS_OPENAI_MODEL=gpt-5.4-mini

# Anthropic Messages API for card images
ANTHROPIC_API_KEY=
UNSPEAKABLE_TRANSLATIONS_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional, separate Google Cloud Translation API
GOOGLE_CLOUD_TRANSLATION_API_KEY=
